<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="mth202-first-day-review">
  <title>Math 202: Some Key Ideas from Math 201</title>

  <introduction>
    <p>
      Today we're going to review a few ideas from Math 201 that will be used
      a lot in this course.
      Please work in groups of three to four students; share your questions
      and observations with your group mates; be prepared to report back to
      the full class.
    </p>
  </introduction>

  <!-- Page 1: Exercises 1 and 2 -->
  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="mth202-derivative-meaning">
      <title>The meaning of the derivative</title>

      <task workspace="1in">
        <statement>
          <p>
            Suppose that <m>f'</m>, the derivative of a function <m>f</m>,
            satisfies <m>f'(2) \gt 0</m>.
            What can you conclude about <m>f</m> near <m>x = 2</m>?
            What about if <m>f'(2) \lt 0</m>?
          </p>
        </statement>
        <solution component="solutions">
          <p>
            If <m>f'(2) \gt 0</m>, then <m>f</m> is increasing near
            <m>x = 2</m> (the graph is rising).
            If <m>f'(2) \lt 0</m>, then <m>f</m> is decreasing near
            <m>x = 2</m> (the graph is falling).
          </p>
        </solution>
      </task>

      <task workspace="1in">
        <statement>
          <p>
            What can you conclude about <m>f</m> if <m>f''(2) \gt 0</m>?
            <m>f''(2) \lt 0</m>?
          </p>
        </statement>
        <solution component="solutions">
          <p>
            If <m>f''(2) \gt 0</m>, then <m>f'</m> is increasing near
            <m>x = 2</m>, so <m>f</m> is concave up there (the graph bends
            upward).
            If <m>f''(2) \lt 0</m>, then <m>f'</m> is decreasing near
            <m>x = 2</m>, so <m>f</m> is concave down there (the graph bends
            downward).
          </p>
        </solution>
      </task>

      <task>
        <statement>
          <p>
            Shown below are the graphs of some functions.
            Provide a sketch of each function's derivative on the axes below
            its graph.
            You don't need to give a perfect graph.
            Instead, you just want to indicate the general behavior of the
            derivative.
          </p>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>
                  A straight line with negative slope crossing the x-axis at
                  x = -1 and the y-axis at y = -1.
                </p>
              </description>
              <prefigure label="mth202-q1-graph-line" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>f(x) = -x - 1</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="f" domain="(-5,4)" stroke="blue" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>
                  An increasing curve that is nearly flat for negative x and
                  rises ever more steeply, crossing the x-axis near x = 2.
                </p>
              </description>
              <prefigure label="mth202-q1-graph-exp" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>f(x) = exp(x/2) - 3</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="f" domain="(-5,4.1)" stroke="blue" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>Blank grid with labeled axes for sketching.</p>
              </description>
              <prefigure label="mth202-q1-blank-1" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>Blank grid with labeled axes for sketching.</p>
              </description>
              <prefigure label="mth202-q1-blank-2" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>
                  A W-shaped curve with a local maximum at the origin and
                  local minima near x = -2 and x = 2, rising steeply
                  outside them.
                </p>
              </description>
              <prefigure label="mth202-q1-graph-quartic" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>f(x) = 0.25*x^4 - 2*x^2</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="f" domain="(-3.16,3.16)" stroke="blue" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>
                  An increasing curve that flattens near x = 0 at a height
                  slightly above the axis and is steeper for larger values
                  of the absolute value of x.
                </p>
              </description>
              <prefigure label="mth202-q1-graph-cubic" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>f(x) = 0.1*x^3 + 0.5</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="f" domain="(-3.8,3.5)" stroke="blue" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>Blank grid with labeled axes for sketching.</p>
              </description>
              <prefigure label="mth202-q1-blank-3" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>Blank grid with labeled axes for sketching.</p>
              </description>
              <prefigure label="mth202-q1-blank-4" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>
        </statement>

        <solution component="solutions">
          <p>
            Sketches of the four derivatives, in the order the functions are
            shown (the vertical scale is the same as on the blank axes, so
            the graphs are cut off where they leave the window):
          </p>
          <ol>
            <li>
              <p>
                The line has constant slope <m>-1</m>, so the derivative is
                the horizontal line <m>y = -1</m>.
              </p>
            </li>
            <li>
              <p>
                The function is always increasing, so the derivative is
                positive everywhere.
                It starts near 0 on the left and increases, getting steeper
                to the right, because the function is concave up.
              </p>
            </li>
            <li>
              <p>
                The derivative is zero at the local extrema <m>x = -2</m>,
                <m>x = 0</m> and <m>x = 2</m>.
                It is negative for <m>x \lt -2</m>, positive between
                <m>-2</m> and <m>0</m>, negative between <m>0</m> and
                <m>2</m>, and positive for <m>x \gt 2</m>.
                The graph looks like a cubic.
              </p>
            </li>
            <li>
              <p>
                The function is increasing everywhere, with a horizontal
                tangent at <m>x = 0</m>.
                The derivative is nonnegative, equals zero at
                <m>x = 0</m>, and increases as <m>x</m> moves away from 0
                in either direction, so it looks like a parabola opening
                upward.
              </p>
            </li>
          </ol>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>A horizontal line at height -1.</p>
              </description>
              <prefigure label="mth202-q1-sol-1" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>g(x) = -1</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="g" domain="(-5,5)" stroke="red" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>
                  A positive increasing curve starting near 0 at the left and
                  rising to about 5 at the right.
                </p>
              </description>
              <prefigure label="mth202-q1-sol-2" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>g(x) = 0.5*exp(x/2)</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="g" domain="(-5,4.6)" stroke="red" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>

          <sidebyside widths="45% 45%">
            <image>
              <description>
                <p>
                  A cubic curve through the origin and the points (-2, 0) and
                  (2, 0): negative for x less than -2, positive between -2 and
                  0, negative between 0 and 2, and positive for x greater
                  than 2.
                </p>
              </description>
              <prefigure label="mth202-q1-sol-3" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>g(x) = x^3 - 4*x</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="g" domain="(-2.4,2.4)" stroke="red" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
            <image>
              <description>
                <p>A parabola opening upward with its vertex at the origin.</p>
              </description>
              <prefigure label="mth202-q1-sol-4" xmlns="https://prefigure.org">
                <diagram dimensions="(300,210)" margins="5">
                  <definition>g(x) = 0.3*x^2</definition>
                  <coordinates bbox="[-5,-5,5,5]">
                    <grid-axes xlabel="x" ylabel="y"/>
                    <graph function="g" domain="(-3.8,3.5)" stroke="red" thickness="2"/>
                  </coordinates>
                </diagram>
              </prefigure>
            </image>
          </sidebyside>
        </solution>
      </task>
    </exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="mth202-antiderivative-sketch">
      <statement>
        <p>
          Shown below are the graphs of two functions.
          On the empty axes below each, sketch the graph of a function
          <alert>whose derivative</alert> is the function shown above.
        </p>

        <sidebyside widths="45% 45%">
          <image>
            <description>
              <p>
                A straight line with negative slope crossing the x-axis at
                x = -1 and the y-axis at y = -1.
              </p>
            </description>
            <prefigure label="mth202-q2-graph-line" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <definition>f(x) = -x - 1</definition>
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                  <graph function="f" domain="(-5,4)" stroke="blue" thickness="2"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
          <image>
            <description>
              <p>
                A wave oscillating between 3 and -3 with period 4, with
                peaks at x = -4, 0 and 4 and troughs at x = -2 and 2.
              </p>
            </description>
            <prefigure label="mth202-q2-graph-wave" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <definition>f(x) = 3*cos(1.5708*x)</definition>
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                  <graph function="f" domain="(-5,5)" stroke="blue" thickness="2"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
        </sidebyside>

        <sidebyside widths="45% 45%">
          <image>
            <description>
              <p>Blank grid with labeled axes for sketching.</p>
            </description>
            <prefigure label="mth202-q2-blank-1" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
          <image>
            <description>
              <p>Blank grid with labeled axes for sketching.</p>
            </description>
            <prefigure label="mth202-q2-blank-2" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
        </sidebyside>
      </statement>

      <solution component="solutions">
        <p>
          Any vertical shift of these graphs also works, since adding a
          constant does not change the derivative.
          For the line (slope <m>-x - 1</m>), a parabola opening downward
          with its vertex at <m>x = -1</m>, such as
          <m>F(x) = -\tfrac{1}{2}x^2 - x + 2</m>.
          For the wave, a sine wave such as
          <m>F(x) = \tfrac{6}{\pi}\sin\left(\tfrac{\pi x}{2}\right)</m>,
          which has its maxima and minima where the wave crosses the x-axis
          (at <m>x = \pm 1, \pm 3</m>) and increases most steeply at
          <m>x = 0</m>, where the wave is at its peak.
        </p>

        <sidebyside widths="45% 45%">
          <image>
            <description>
              <p>
                A downward-opening parabola with its vertex at (-1, 2.5).
              </p>
            </description>
            <prefigure label="mth202-q2-sol-1" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <definition>F(x) = -0.5*x^2 - x + 2</definition>
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                  <graph function="F" domain="(-4.5,2.5)" stroke="red" thickness="2"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
          <image>
            <description>
              <p>
                A sine wave with amplitude about 1.9 and period 4, with
                maxima at x = -3 and x = 1 and minima at x = -1 and x = 3.
              </p>
            </description>
            <prefigure label="mth202-q2-sol-2" xmlns="https://prefigure.org">
              <diagram dimensions="(300,210)" margins="5">
                <definition>F(x) = 1.9099*sin(1.5708*x)</definition>
                <coordinates bbox="[-5,-5,5,5]">
                  <grid-axes xlabel="x" ylabel="y"/>
                  <graph function="F" domain="(-5,5)" stroke="red" thickness="2"/>
                </coordinates>
              </diagram>
            </prefigure>
          </image>
        </sidebyside>
      </solution>
    </exercise>
  </page>

  <!-- Page 2: Exercise 3 -->
  <page>
    <exercise xml:id="mth202-distance-from-velocity">
      <title>Distance from velocity</title>

      <introduction>
        <p>
          Suppose you take a trip in your car and measure your velocity for
          30 seconds at 5-second intervals:
        </p>

        <tabular top="minor" left="minor" bottom="minor" right="minor">
          <col halign="left" right="minor"/>
          <col halign="center"/>
          <col halign="center"/>
          <col halign="center"/>
          <col halign="center"/>
          <col halign="center"/>
          <col halign="center"/>
          <col halign="center"/>
          <row bottom="minor">
            <cell>time (seconds)</cell>
            <cell>0</cell>
            <cell>5</cell>
            <cell>10</cell>
            <cell>15</cell>
            <cell>20</cell>
            <cell>25</cell>
            <cell>30</cell>
          </row>
          <row>
            <cell>velocity (feet/second)</cell>
            <cell>10</cell>
            <cell>25</cell>
            <cell>35</cell>
            <cell>45</cell>
            <cell>50</cell>
            <cell>60</cell>
            <cell>70</cell>
          </row>
        </tabular>
      </introduction>

      <task workspace="1.5in">
        <statement>
          <p>
            Estimate how far you travel during the first five seconds.
            There are a couple of ways you could do this; write one sentence
            that explains what you did and share it with your group mates.
          </p>
        </statement>
        <solution component="solutions">
          <p>
            Since the velocity is increasing, using the starting velocity of
            10 ft/s for 5 seconds gives a low estimate of
            <m>10 \cdot 5 = 50</m> feet, and using the ending velocity of
            25 ft/s gives a high estimate of <m>25 \cdot 5 = 125</m> feet.
            Averaging the two velocities gives
            <m>\tfrac{10 + 25}{2} \cdot 5 = 87.5</m> feet, which is a
            reasonable single estimate.
            (Answers will vary with the method chosen.)
          </p>
        </solution>
      </task>

      <task workspace="1.5in">
        <statement>
          <p>
            Give upper and lower estimates for the distance traveled over the
            30-second interval.
          </p>
        </statement>
        <solution component="solutions">
          <p>
            Because the velocity is always increasing, the left-endpoint
            velocities give a lower estimate and the right-endpoint
            velocities give an upper estimate.
            <md>
              <mrow>\text{lower} \amp = 5(10 + 25 + 35 + 45 + 50 + 60) = 1125 \text{ feet}</mrow>
              <mrow>\text{upper} \amp = 5(25 + 35 + 45 + 50 + 60 + 70) = 1425 \text{ feet}</mrow>
            </md>
          </p>
        </solution>
      </task>

      <task workspace="1in">
        <statement>
          <p>
            Estimate your average velocity over the 30-second interval.
          </p>
        </statement>
        <solution component="solutions">
          <p>
            The average velocity is the distance traveled divided by the
            elapsed time.
            Using the midpoint of the two estimates,
            <m>\tfrac{1125 + 1425}{2} = 1275</m> feet, gives an average
            velocity of about <m>\tfrac{1275}{30} = 42.5</m> feet per second.
            The upper and lower estimates show that the actual average
            velocity is between <m>37.5</m> and <m>47.5</m> feet per second.
          </p>
        </solution>
      </task>
    </exercise>
  </page>

  <!-- Page 3: Exercise 4 -->
  <page>
    <exercise xml:id="mth202-geometric-integrals">
      <title>Geometric interpretation of definite integrals</title>

      <introduction>
        <p>
          Shown below is the graph of a function <m>f(x)</m>.
        </p>

        <image width="50%">
          <description>
            <p>
              A piecewise linear graph of y = f(x). It rises from (0, 0) to
              (1, 2), falls to (2, -2) crossing the x-axis at x = 1.5, stays
              at -2 until x = 3, then rises to (4, 0).
            </p>
          </description>
          <prefigure label="mth202-q4-graph" xmlns="https://prefigure.org">
            <diagram dimensions="(300,300)" margins="5">
              <definition>f1(x) = 2*x</definition>
              <definition>f2(x) = 6 - 4*x</definition>
              <definition>f3(x) = -2</definition>
              <definition>f4(x) = 2*x - 8</definition>
              <coordinates bbox="[-0.5,-2.5,4.5,2.5]">
                <grid-axes xlabel="x" ylabel="y"/>
                <graph function="f1" domain="(0,1)" stroke="blue" thickness="3"/>
                <graph function="f2" domain="(1,2)" stroke="blue" thickness="3"/>
                <graph function="f3" domain="(2,3)" stroke="blue" thickness="3"/>
                <graph function="f4" domain="(3,4)" stroke="blue" thickness="3"/>
                <label anchor="(1.25,1.6)" alignment="e">
                  <m>y = f(x)</m>
                </label>
              </coordinates>
            </diagram>
          </prefigure>
        </image>

        <p>Evaluate the definite integrals:</p>
      </introduction>

      <task workspace="0.75in">
        <statement>
          <p><m>\displaystyle\int_0^1 f(x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            The region is a triangle with base 1 and height 2, so the
            integral is <m>\tfrac{1}{2}(1)(2) = 1</m>.
          </p>
        </solution>
      </task>

      <task workspace="0.75in">
        <statement>
          <p><m>\displaystyle\int_0^2 f(x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            From 0 to 1.5 the graph is above the axis, bounding a triangle of
            area <m>\tfrac{1}{2}(1.5)(2) = 1.5</m>.
            From 1.5 to 2 it is below the axis, bounding a triangle of area
            <m>\tfrac{1}{2}(0.5)(2) = 0.5</m> that counts negatively.
            The integral is <m>1.5 - 0.5 = 1</m>.
          </p>
        </solution>
      </task>

      <task workspace="0.75in">
        <statement>
          <p><m>\displaystyle\int_0^3 f(x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            Add the rectangle between <m>x = 2</m> and <m>x = 3</m>, which
            lies below the axis with area <m>(1)(2) = 2</m> counting
            negatively: <m>1 - 2 = -1</m>.
          </p>
        </solution>
      </task>

      <task workspace="0.75in">
        <statement>
          <p><m>\displaystyle\int_0^4 f(x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            Add the triangle between <m>x = 3</m> and <m>x = 4</m>, which
            lies below the axis with area <m>\tfrac{1}{2}(1)(2) = 1</m>
            counting negatively: <m>-1 - 1 = -2</m>.
          </p>
        </solution>
      </task>

      <task workspace="0.75in">
        <statement>
          <p><m>\displaystyle\int_2^4 f(x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            Only the rectangle from 2 to 3 (area 2) and the triangle from 3
            to 4 (area 1) are involved, and both lie below the axis:
            <m>-2 - 1 = -3</m>.
          </p>
        </solution>
      </task>
    </exercise>
  </page>

  <!-- Page 4: Exercise 5 -->
  <page>
    <exercise xml:id="mth202-evaluate-integrals">
      <title>Evaluation of some definite integrals</title>

      <introduction>
        <p>
          Evaluate each definite integral exactly using an important result
          from first-semester calculus.
        </p>
      </introduction>

      <task workspace="1.5in">
        <statement>
          <p><m>\displaystyle\int_{-1}^{3} (3x^2 + x)\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            By the Fundamental Theorem of Calculus, using the antiderivative
            <m>x^3 + \tfrac{1}{2}x^2</m>,
            <md>
              \left[x^3 + \tfrac{1}{2}x^2\right]_{-1}^{3}
              = \left(27 + \tfrac{9}{2}\right) - \left(-1 + \tfrac{1}{2}\right)
              = 32.
            </md>
          </p>
        </solution>
      </task>

      <task workspace="1.5in">
        <statement>
          <p><m>\displaystyle\int_0^{3\pi/4} \sin x\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            <md>
              \left[-\cos x\right]_0^{3\pi/4}
              = -\cos\left(\tfrac{3\pi}{4}\right) + \cos 0
              = \tfrac{\sqrt{2}}{2} + 1.
            </md>
          </p>
        </solution>
      </task>

      <task workspace="1.5in">
        <statement>
          <p><m>\displaystyle\int_0^2 e^x\,dx</m></p>
        </statement>
        <solution component="solutions">
          <p>
            <md>
              \left[e^x\right]_0^2 = e^2 - e^0 = e^2 - 1.
            </md>
          </p>
        </solution>
      </task>
    </exercise>
  </page>
</worksheet>
